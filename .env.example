# PostgreSQL
POSTGRES_USER=grocery
POSTGRES_PASSWORD=grocery_dev
POSTGRES_DB=grocery_receipt

# Backend
DATABASE_URL=postgresql+asyncpg://grocery:grocery_dev@db:5432/grocery_receipt
DATABASE_URL_TEST=postgresql+asyncpg://grocery:grocery_dev@db:5432/grocery_receipt_test
SECRET_KEY=change-me-in-production
DEBUG=true

# Gemini AI (extracción de tickets)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

# Google Drive (sync automático de tickets)
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# Límite de llamadas a Gemini por sync (0 = ilimitado)
GEMINI_BATCH_LIMIT=0

# API auth: clave obligatoria cuando DEBUG=false (la API se niega a arrancar sin ella).
# Con DEBUG=true se permite dejarla vacía (solo desarrollo, se emite un warning).
API_KEY=

# Tamaño máximo (bytes) de un PDF, tanto en /tickets/upload (413) como en el sync de Drive (se omite)
MAX_UPLOAD_BYTES=10485760

# CORS (comma-separated origins; localhost:* is always allowed for dev)
CORS_ORIGINS=
